# Identificador não secreto do projeto Firebase usado pelo servidor.
FIREBASE_PROJECT_ID=demo-sistema-cabelo

# Configuração pública do Firebase usada apenas no navegador.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sistema-cabelo

# Em produção, disponibilize credenciais do Firebase Admin fora do repositório,
# por exemplo por identidade de serviço da plataforma ou GOOGLE_APPLICATION_CREDENTIALS.
