{
  "name": "sistema-cabelo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "firebase emulators:exec --config firebase.test.json --project demo-sistema-cabelo --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:auth": "firebase emulators:exec --config firebase.test.json --project demo-sistema-cabelo --only auth,firestore \"playwright test --config playwright.auth.config.ts\"",
    "emulators": "firebase emulators:start --project demo-sistema-cabelo",
    "firebase:set-admin": "node --env-file=.env.local scripts/set-admin-claims.mjs"
  },
  "dependencies": {
    "firebase": "12.17.0",
    "firebase-admin": "14.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "15.25.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
